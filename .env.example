# Copy this file to ".env" and change the values if you want.
# The real ".env" is ignored by Git. Never put real secrets in this example file.

# Maximum size of one uploaded file, in megabytes
MAX_UPLOAD_MB=10

# Where the server listens (keep 127.0.0.1 so only your own computer can open it)
HOST=127.0.0.1
PORT=5000

# 1 = Flask debug mode (only on your own laptop), 0 = off
FLASK_DEBUG=0

# Phase 2 (AWS S3) settings will be added later.
# Do NOT put AWS access keys in any file that goes to GitHub.
